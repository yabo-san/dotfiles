setup
# age private key — never deployed, never managed
.config/age/keys.txt
# repo docs: stay in the repo for GitHub, never copied into ~
README.md
# entry script — fetched + run BEFORE chezmoi exists; never deployed to ~
bootstrap.ps1
bootstrap.sh

# python bytecode — never deploy, never track
**/__pycache__/**
.config/scripts/hydra/node_modules/**
.config/scripts/hydra/package-lock.json
**/*.pyc

# ── OS gating: each platform only applies its own files ──────────────────
# Patterns below match TARGET paths (post dot_/private_ rename), not source names.
# On Windows, skip all the mac-only configs:
{{ if eq .chezmoi.os "windows" }}
Brewfile
.bashrc
.zshrc
.tmux.conf
.config/aerospace/**
.config/ghostty/**
.config/karabiner/**
.config/mise/**
.config/sketchybar/**
.chezmoiexternals/**
{{ end }}

# On mac/Linux, skip all the Windows-only configs:
# Scripts are NOT listed here: each one in .chezmoiscripts/<os>/ wraps itself
# in an OS if-guard (template), and chezmoi skips a script that renders empty.
{{ if ne .chezmoi.os "windows" }}
.local/share/emulators/**
.glzr/**
.config/wezterm/**
.config/yasb/**
.config/scripts/**
.config/powershell/**
.config/starship.toml
.config/bootstrap/**
.config/fastfetch/**
.config/obsidian/**
.config/monitors.json
.config/playnite/**
.wslconfig
{{ end }}
# NOTE: .config/bat IS shared (mac + Windows) — the preferred bat style.

# launchd agents are macOS-only (e.g. always-on backend services)
{{ if ne .chezmoi.os "darwin" }}
Library/**
{{ end }}

# ── Linux == the Ubuntu devcontainer (the ONLY Linux this repo ever targets) ──
# Windows and Mac are the daily drivers; Linux only exists as the pinned
# ubuntu-24.04 devcontainer. So strip it to dev-shell essentials -- keep
# bash/zsh/tmux/mise/git/nvim/bat, drop the mac-GUI configs that leak through
# the ne-windows block above, and drop ALL personal secrets: an injected
# client workspace must never carry your home-cluster key or desktop config.
{{ if eq .chezmoi.os "linux" }}
Brewfile
.config/aerospace/**
.config/ghostty/**
.config/karabiner/**
.config/sketchybar/**
.ssh/**
{{ end }}

# nvim is shared (LazyVim overrides apply on both) — never ignored.



