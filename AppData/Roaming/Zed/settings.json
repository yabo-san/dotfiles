// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": { "dock": "left" },
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow"
    }
  },
  "auto_update": false,
  // C# (OmniSharp) for the Chisel SDK; Zed installs it on next launch
  "auto_install_extensions": { "csharp": true },
  "minimap": {
    "show": "always"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "default"
      },
      "type": "registry"
    },
    // OpenCode over ACP (the owner plans to move off Claude; same panel, same protocol)
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "languages": {
    "Markdown": { "soft_wrap": "editor_width" },
  },
}
