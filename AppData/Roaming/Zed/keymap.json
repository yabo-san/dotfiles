// Alt sits where the Mac's Cmd is (dot_config/bootstrap/keyboard-map.md). These are Zed's Ctrl
// shortcuts moved to Alt, so the thumb does what Cmd does on the Mac. Copy, cut, paste, select all
// and undo are already Alt everywhere through AHK, so they are not repeated here.
// Windows only: chezmoi skips AppData/ everywhere else, and the Mac's Zed uses Cmd natively.
// Not here on purpose: Alt+Shift+G is Playnite's global hotkey, so the Git panel stays on Zed's default.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-p": "command_palette::Toggle",
      "alt-p": "file_finder::Toggle",
      "alt-s": "workspace::Save",
      "alt-w": "pane::CloseActiveItem",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-j": "workspace::ToggleBottomDock",
      "alt-,": "zed::OpenSettings",
      "alt-shift-e": "project_panel::ToggleFocus",
      "alt-shift-f": "pane::DeploySearch"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-f": "buffer_search::Deploy",
      "alt-/": "editor::ToggleComments",
      "alt-d": ["editor::SelectNext", { "replace_newest": false }]
    }
  }
]
