{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: writes a one-line $PROFILE under Documents that loads the chezmoi-managed profile.
# PowerShell only reads profiles from Documents (often OneDrive-redirected, so resolved at runtime). Re-runs when the profile changes:
#   {{ include "dot_config/powershell/Microsoft.PowerShell_profile.ps1" | sha256sum }}
# A skip must exit non-zero: chezmoi marks a run_onchange script that exits 0 as done and never retries.
$ErrorActionPreference = 'Stop'

$target = Join-Path ([Environment]::GetFolderPath('MyDocuments')) 'PowerShell\profile.ps1'
$source = Join-Path $env:USERPROFILE '.config\powershell\Microsoft.PowerShell_profile.ps1'

if (-not (Test-Path $source)) {
    Write-Host "[profile] chezmoi profile missing: $source" -ForegroundColor Yellow
    exit 1
}

$bridge = @"
# Loaded by PowerShell as `$PROFILE.CurrentUserAllHosts.
# GENERATED by chezmoi (run_onchange_after_powershell-profile-bridge.ps1) — do
# not edit. PowerShell only reads profiles from under Documents, so this exists
# purely to hand off to the chezmoi-managed profile. Put real content THERE:
#   ~/.config/powershell/Microsoft.PowerShell_profile.ps1
`$chezmoiProfile = Join-Path `$env:USERPROFILE '.config\powershell\Microsoft.PowerShell_profile.ps1'
if (Test-Path `$chezmoiProfile) { . `$chezmoiProfile }
"@

New-Item -ItemType Directory -Force (Split-Path $target) | Out-Null

if ((Test-Path $target) -and ((Get-Content $target -Raw) -eq $bridge)) {
    Write-Host "[profile] bridge already current." -ForegroundColor DarkGray
    return
}

# The existing file may be an untracked real profile, so back it up once.
if (Test-Path $target) {
    $backup = "$target.bak-yabo"
    if (-not (Test-Path $backup)) {
        Copy-Item $target $backup -Force
        Write-Host "[profile] backed up the previous profile -> $backup" -ForegroundColor DarkGray
    }
}

Set-Content -Path $target -Value $bridge -Encoding UTF8
Write-Host "[profile] bridged $target -> chezmoi profile" -ForegroundColor Green
{{ end -}}
