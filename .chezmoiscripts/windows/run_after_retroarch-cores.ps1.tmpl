{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: copies the non-Steam cores the retroarch-cores external fetched into Steam RetroArch.
# run_after, not run_onchange: the nightly cores change without this script changing. Copies only on hash change.
$ErrorActionPreference = 'Stop'

$src = Join-Path $env:USERPROFILE '.local\share\retroarch-cores'
if (-not (Test-Path $src)) { Write-Host "[retroarch-cores] nothing fetched yet." -ForegroundColor DarkGray; return }

$steam = (Get-ItemProperty 'HKCU:\Software\Valve\Steam' -ErrorAction SilentlyContinue).SteamPath
$ra = if ($steam) { Join-Path ($steam -replace '/', '\') 'steamapps\common\RetroArch' }
if (-not $ra -or -not (Test-Path (Join-Path $ra 'retroarch.exe'))) {
    Write-Host "[retroarch-cores] Steam RetroArch not found - install it from Steam, then 'chezmoi apply'." -ForegroundColor Yellow
    return
}
if (Get-Process retroarch -ErrorAction SilentlyContinue) {
    Write-Host "[retroarch-cores] RetroArch is running - close it and 'chezmoi apply' again." -ForegroundColor Yellow
    return
}

$changed = 0
foreach ($f in Get-ChildItem $src -Recurse -File -Include *_libretro.dll, *_libretro.info) {
    $destDir = if ($f.Extension -eq '.dll') { Join-Path $ra 'cores' } else { Join-Path $ra 'info' }
    $dest = Join-Path $destDir $f.Name
    if ((Test-Path $dest) -and (Get-FileHash $dest).Hash -eq (Get-FileHash $f.FullName).Hash) { continue }
    Copy-Item $f.FullName $dest -Force
    Write-Host "[retroarch-cores] updated $($f.Name)" -ForegroundColor Cyan
    $changed++
}
if ($changed -eq 0) { Write-Host "[retroarch-cores] Brimir, SwanStation, LRPS2 up to date." -ForegroundColor DarkGray }
{{ end -}}
