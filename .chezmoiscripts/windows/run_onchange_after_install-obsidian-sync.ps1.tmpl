{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: clones the Obsidian sync daemon to D:\REPOS and builds its venv. Idempotent.
# A script, not .chezmoiexternals, because the repo is outside the home dir. A venv because scoop updates wipe site-packages.
# Re-runs when the config changes:
#   {{ include "dot_config/obsidian/sync-config.yaml" | sha256sum }}
# A skip must exit non-zero: chezmoi marks a run_onchange script that exits 0 as done and never retries.
$ErrorActionPreference = 'Stop'

$repo    = 'D:\REPOS\obsidian-icloud-windows-sync'
# yabo-san fork: adds the quiet-period debounce (sync.quiet_period).
$url     = 'https://github.com/yabo-san/obsidian-icloud-windows-sync.git'
$venvPy  = Join-Path $repo '.venv\Scripts\python.exe'

if (-not (Test-Path 'D:\')) {
    Write-Host '[obsidian-sync] no D: drive - skipping (not this machine).' -ForegroundColor DarkGray
    return
}

if (-not (Test-Path (Join-Path $repo '.git'))) {
    Write-Host "[obsidian-sync] cloning to $repo ..." -ForegroundColor Cyan
    New-Item -ItemType Directory -Force (Split-Path $repo) | Out-Null
    & git clone --quiet $url $repo
    if ($LASTEXITCODE -ne 0) { Write-Host '[obsidian-sync] clone failed.' -ForegroundColor Red; exit 1 }
} else {
    Write-Host '[obsidian-sync] repo present.' -ForegroundColor DarkGray
}

if (-not (Test-Path $venvPy)) {
    Write-Host '[obsidian-sync] creating venv ...' -ForegroundColor Cyan
    & python -m venv (Join-Path $repo '.venv')
    if (-not (Test-Path $venvPy)) { Write-Host '[obsidian-sync] venv creation failed.' -ForegroundColor Red; exit 1 }
}

# Reinstall only when the venv cannot import the package.
& $venvPy -c 'import obsidian_sync, yaml, watchdog, colorama, aiofiles' 2>$null
if ($LASTEXITCODE -ne 0) {
    Write-Host '[obsidian-sync] installing package + deps into venv ...' -ForegroundColor Cyan
    & $venvPy -m pip install --quiet --upgrade pip
    & $venvPy -m pip install --quiet $repo
    & $venvPy -c 'import obsidian_sync, yaml, watchdog, colorama, aiofiles' 2>$null
    if ($LASTEXITCODE -ne 0) { Write-Host '[obsidian-sync] deps still missing after install.' -ForegroundColor Red; exit 1 }
}

Write-Host '[obsidian-sync] ready. The daemon starts at logon (obsidian-sync.lnk).' -ForegroundColor Green
{{ end -}}
