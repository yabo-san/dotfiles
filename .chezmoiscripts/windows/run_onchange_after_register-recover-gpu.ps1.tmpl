{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: registers recover-gpu.ps1 as a SYSTEM startup task, which re-enables the GPU if a hard freeze left it disabled.
# Needs one UAC prompt, only when the task is missing or stale. A declined prompt exits 1 so the next apply asks again.
# Re-runs when the recovery script changes:
#   {{ include "dot_config/scripts/gpu/recover-gpu.ps1" | sha256sum }}
$ErrorActionPreference = 'Stop'

$name   = 'recover-gpu'
$script = Join-Path $env:USERPROFILE '.config\scripts\gpu\recover-gpu.ps1'
$args_  = "-NoProfile -ExecutionPolicy Bypass -File `"$script`""

if (-not (Test-Path $script)) {
    Write-Host "[recover-gpu] $script not deployed yet - run 'chezmoi apply' again." -ForegroundColor Yellow
    exit 1
}

$receipt = Join-Path $env:LOCALAPPDATA 'recover-gpu\registered.txt'
$want    = "SYSTEM|$args_"
if ((Test-Path $receipt) -and ((Get-Content $receipt -Raw).Trim() -eq $want)) {
    Write-Host "[recover-gpu] startup task already registered." -ForegroundColor DarkGray
    return
}
New-Item -ItemType Directory -Force (Split-Path $receipt) | Out-Null
Remove-Item $receipt -ErrorAction SilentlyContinue

# The elevated part runs from a file with -File: inline -Command through RunAs mangles the quotes. It logs next to the receipt.
$dir     = Split-Path $receipt
$elevPs1 = Join-Path $dir 'register.ps1'
$elevLog = Join-Path $dir 'register.log'
@"
`$ErrorActionPreference = 'Stop'
Start-Transcript -Path '$elevLog' -Force | Out-Null
try {
    `$a = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '$($args_ -replace "'", "''")'
    `$t = New-ScheduledTaskTrigger -AtStartup
    `$s = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Minutes 5)
    Register-ScheduledTask -TaskName '$name' -Action `$a -Trigger `$t -Settings `$s -User 'SYSTEM' -RunLevel Highest -Force | Out-Null
    `$r = Get-ScheduledTask -TaskName '$name'
    "registered: user=`$(`$r.Principal.UserId) args=`$(`$r.Actions[0].Arguments)"
    if (`$r.Principal.UserId -match 'SYSTEM') { 'SYSTEM|' + `$r.Actions[0].Arguments | Set-Content -Encoding utf8 '$receipt' }
} catch {
    "FAILED: `$(`$_.Exception.Message)"
    exit 1
} finally { Stop-Transcript | Out-Null }
"@ | Set-Content -Encoding utf8 $elevPs1

Write-Host "[recover-gpu] registering the startup task - approve the UAC prompt." -ForegroundColor Cyan
try {
    $p = Start-Process powershell.exe -Verb RunAs -WindowStyle Hidden -PassThru -Wait `
        -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$elevPs1`""
} catch {
    Write-Host "[recover-gpu] UAC declined - not registered. Next 'chezmoi apply' asks again." -ForegroundColor Yellow
    exit 1
}

if ((Test-Path $receipt) -and ((Get-Content $receipt -Raw).Trim() -eq $want)) {
    Write-Host "[recover-gpu] registered: runs at startup as SYSTEM." -ForegroundColor Green
} else {
    Write-Host "[recover-gpu] elevated step exited $($p.ExitCode) without a matching receipt. Its log:" -ForegroundColor Red
    Get-Content $elevLog -ErrorAction SilentlyContinue | Select-String -NotMatch '^\*{5,}|^(Start|End) time|^(Username|RunAs User|Configuration Name|Machine|Host Application|Process ID|PSVersion|PSEdition|PSCompatibleVersions|BuildVersion|CLRVersion|WSManStackVersion|PSRemotingProtocolVersion|SerializationVersion|OS):' | ForEach-Object { Write-Host "    $_" }
    exit 1
}
{{ end -}}
