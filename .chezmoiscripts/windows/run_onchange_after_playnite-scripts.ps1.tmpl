{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: writes one-line stubs into Playnite's config.json that call the tracked pre/post-game scripts.
# Re-runs when either script changes:
#   pre-game.ps1        {{ include "dot_config/scripts/playnite/pre-game.ps1"        | sha256sum }}
#   post-game.ps1       {{ include "dot_config/scripts/playnite/post-game.ps1"       | sha256sum }}
# A skip must exit non-zero: chezmoi marks a run_onchange script that exits 0 as done and never retries.
$ErrorActionPreference = 'Stop'

$cfgPath = Join-Path $env:APPDATA 'Playnite\config.json'
if (-not (Test-Path $cfgPath)) {
    Write-Host "[playnite] no config.json yet — run Playnite once, then 'chezmoi apply'." -ForegroundColor Yellow
    exit 1
}

# Playnite rewrites config.json on exit and would undo this, so skip while it runs.
if (Get-Process 'Playnite*' -ErrorAction SilentlyContinue) {
    Write-Host "[playnite] Playnite is running — close it and re-run 'chezmoi apply'." -ForegroundColor Yellow
    exit 1
}

$dir = '$env:USERPROFILE\.config\scripts\playnite'
$stubs = @{
    # Thin stubs that call the tracked scripts.
    PreScript         = "`$s=`"$dir\pre-game.ps1`"; if (Test-Path `$s) { & `$s -Game `$Game }"
    PostScript        = "`$s=`"$dir\post-game.ps1`"; if (Test-Path `$s) { & `$s -Game `$Game }"

    # Both empty on purpose, so machines with an old stub get it cleared.
    GameStartedScript = ""
    AppStartupScript  = ""
}

$raw = Get-Content $cfgPath -Raw
$cfg = $raw | ConvertFrom-Json

$changed = $false
foreach ($key in $stubs.Keys) {
    $current = $cfg.PSObject.Properties[$key]
    if ($null -eq $current) {
        $cfg | Add-Member -NotePropertyName $key -NotePropertyValue $stubs[$key]
        $changed = $true
    }
    elseif ($current.Value -ne $stubs[$key]) {
        $current.Value = $stubs[$key]
        $changed = $true
    }
}

if (-not $changed) {
    Write-Host "[playnite] global script stubs already current." -ForegroundColor DarkGray
    return
}

# Keep one rollback copy: this file holds every Playnite setting.
Copy-Item $cfgPath "$cfgPath.bak" -Force
$cfg | ConvertTo-Json -Depth 100 | Set-Content $cfgPath -Encoding UTF8

Write-Host "[playnite] global script stubs installed (backup: config.json.bak)" -ForegroundColor Green
Write-Host "           bodies live in ~/.config/scripts/playnite/ and are chezmoi-tracked." -ForegroundColor DarkGray
{{ end -}}
