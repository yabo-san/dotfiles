{{ if eq .chezmoi.os "windows" -}}
#requires -Version 5.1
# chezmoi apply: generates the Startup folder shortcuts that bring the desktop up at logon.
# Rewrites a shortcut only when its target or args drift, and skips any target not installed yet.
# {{ .chezmoi.os }}: re-runs if the OS context changes
$ErrorActionPreference = 'Stop'

$startup = Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs\Startup'
New-Item -ItemType Directory -Force $startup | Out-Null

$shortcuts = @(
    @{
        Name   = 'GlazeWM.lnk'
        Target = 'C:\Program Files\glzr.io\GlazeWM\glazewm.exe'
        Args   = ''
        Why    = 'tiling window manager'
    },
    @{
        Name   = 'YASB.lnk'
        Target = 'C:\Program Files\YASB\yasb.exe'
        Args   = ''
        Why    = 'status bar (will not start on boot without this)'
    },
    @{
        # scoop 'current' junction, so this survives AutoHotkey upgrades.
        Name   = 'hotkeys.lnk'
        Target = "$env:USERPROFILE\scoop\apps\autohotkey\current\v2\AutoHotkey64.exe"
        Args   = "`"$env:USERPROFILE\.config\scripts\hotkeys.ahk`""
        Why    = 'all AutoHotkey bindings: drop-downs, Win+D, Alt remaps'
    },
    @{
        Name   = 'MEGAsync.lnk'
        Target = 'C:\ProgramData\MEGAsync\MEGAsync.exe'
        Args   = ''
        Why    = 'file sync'
    },
    @{
        # The CRT's GDI device number drifts after display resets; re-resolve it at logon.
        # Windows PowerShell with -NoProfile: always present and skips the profile bridge.
        Name   = 'yasb-crt-bar.lnk'
        Target = "$env:SystemRoot\System32\conhost.exe"   # --headless: no console flash at logon
        Args   = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$env:USERPROFILE\.config\scripts\yasb\fix-crt-bar.ps1`""
        Why    = 're-point the yasb CRT bar at whatever DISPLAYn the CRT is today'
    },
    @{
        # RetroArch picks its screen by enumeration index, which drifts. Resolved by resolution at logon.
        Name   = 'retroarch-crt.lnk'
        Target = "$env:SystemRoot\System32\conhost.exe"   # --headless: no console flash at logon
        Args   = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$env:USERPROFILE\.config\scripts\retroarch\bind-crt.ps1`""
        Why    = 'point RetroArch video_monitor_index at whatever monitor the CRT is today'
    },
    @{
        # Wrapper script guards venv/config, feeds stdin, and no-ops if the daemon is already up.
        Name   = 'obsidian-sync.lnk'
        Target = "$env:SystemRoot\System32\conhost.exe"   # --headless: no console flash at logon
        Args   = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$env:USERPROFILE\.config\scripts\obsidian\start-sync-daemon.ps1`""
        Why    = 'Obsidian local<->iCloud sync daemon'
    },
    @{
        # Windows reconnects mapped drives before Tailscale is up, so N: stays Unavailable. This waits, then remounts.
        Name   = 'mount-nas.lnk'
        Target = "$env:SystemRoot\System32\conhost.exe"   # --headless: no console flash at logon
        Args   = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$env:USERPROFILE\.config\scripts\nas\mount-nas.ps1`""
        Why    = 'wait for Tailscale, then mount N: (thinkserver NAS)'
    }
)

$shell   = New-Object -ComObject WScript.Shell
# Retired: quake-hotkey.lnk would start a second AutoHotkey and bind every key twice.
foreach ($old in @('quake-hotkey.lnk')) {
    $p = Join-Path $startup $old
    if (Test-Path $p) { Remove-Item $p -Force; Write-Host "[startup] removed retired $old" -ForegroundColor Green }
}

$made    = @()
$skipped = @()

foreach ($s in $shortcuts) {
    $lnk = Join-Path $startup $s.Name

    if (-not (Test-Path $s.Target)) {
        $skipped += "$($s.Name) (not installed: $($s.Target))"
        continue
    }

    if (Test-Path $lnk) {
        $existing = $shell.CreateShortcut($lnk)
        if ($existing.TargetPath -eq $s.Target -and $existing.Arguments -eq $s.Args) {
            continue   # already correct
        }
    }

    $sc = $shell.CreateShortcut($lnk)
    $sc.TargetPath       = $s.Target
    $sc.Arguments        = $s.Args
    $sc.WorkingDirectory = Split-Path $s.Target
    $sc.Description      = $s.Why
    $sc.Save()
    $made += $s.Name
}

if ($made)    { Write-Host "[startup] wrote: $($made -join ', ')" -ForegroundColor Green }
if ($skipped) { foreach ($s in $skipped) { Write-Host "[startup] skipped $s" -ForegroundColor DarkYellow } }
if (-not $made -and -not $skipped) { Write-Host "[startup] all shortcuts current." -ForegroundColor DarkGray }
{{ end -}}
