{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# env, NOT /bin/bash: NixOS provides /bin/sh and /usr/bin/env but deliberately
# no /bin/bash, so a hardcoded path fails exec with ENOENT there. Works
# unchanged on macOS and the Ubuntu devcontainer.
# packages hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
$HOME/.local/bin/mise trust $HOME/.config/mise/config.toml && $HOME/.local/bin/mise install

{{ end -}}
