Windows Registry Editor Version 5.00

; windows-tweaks.reg: registry state the setup depends on. Import, then restart Explorer. See WINDOWS-REGISTRY.md.

; Free Win+L from the lock action so Raycast can bridge it.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\System]
"DisableLockWorkstation"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"MMTaskbarEnabled"=dword:00000001

; Taskbar auto-hide is a StuckRects3 blob and can't be set here: toggle it in Settings.

; Classic right-click menu. Replaces the Windhawk mod, which crashed File Pilot via DLL injection.
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

; Toasts off, notification backend on (YASB's bell reads it). Never set DisableNotificationCenter.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\PushNotifications]
"ToastEnabled"=dword:00000000

; Ctrl+Shift+Esc / all Task Manager invocations -> System Informer (IFEO debugger)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\taskmgr.exe]
"Debugger"="{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\scoop\\apps\\systeminformer\\current\\SystemInformer.exe"

; PrtSc opens the native Snipping Tool overlay.
[HKEY_CURRENT_USER\Control Panel\Keyboard]
"PrintScreenKeyForSnippingEnabled"=dword:00000001
"PrintScreenKeyForSnippingTool"=dword:00000001

; XDG_CONFIG_HOME system-wide so XDG-aware apps read ~/.config. Needs a relog.
[HKEY_CURRENT_USER\Environment]
"XDG_CONFIG_HOME"="{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\.config"

; Win+E opens File Pilot: per-user override of the File Explorer shell object. The empty
; DelegateExecute stops Explorer from claiming the verb itself.
[HKEY_CURRENT_USER\Software\Classes\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1}\shell\opennewwindow\command]
@="\"{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Voidstar.FilePilot_Microsoft.Winget.Source_8wekyb3d8bbwe\\FPilot.exe\" \"%1\""
"DelegateExecute"=""

; Store apps at logon can't use the Run key; their StartupTask State lives here (2 = on).
; Import after winget import so the packages exist.
[HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\SystemAppData\28017CharlesMilette.TranslucentTB_v826wp6bftszj\TranslucentTB]
"State"=dword:00000002
"UserEnabledStartupOnce"=dword:00000001

[HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\SystemAppData\40459File-New-Project.EarTrumpet_1sdd7yawvg6ne\EarTrumpet]
"State"=dword:00000002

[HKEY_CURRENT_USER\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\SystemAppData\Raycast.Raycast_qypenmj9wpt2a\LaunchRaycastOnStartup]
"State"=dword:00000002

; Disable Copilot (inerts Win+C, removes its taskbar button).
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"ShowCopilotButton"=dword:00000000
; Disabled Win+<key> combos (Raycast / Open-Shell / YASB cover them). Not S: blocking it also kills
; Win+Shift+S. Needs an Explorer restart or relogin.
"DisabledHotkeys"="IXNQBOR"

; Widgets (Win+W) is removed at the app level: Get-AppxPackage *WebExperience* | Remove-AppxPackage
