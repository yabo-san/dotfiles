{{/*
  launchers.toml — the one game launcher chezmoi installs, plus one emulator.

  THE MODEL (2026-10-03): Playnite is the hub and y4bo is the only launcher
  chezmoi puts on the machine. Everything game-shaped that comes from a GitHub
  release or an archive.org zip is installed BY y4bo, from its shelf, into
  D:\games (the snesrev launcher included). chezmoi can download arbitrary
  binaries from GitHub, but it can only place them; it has no idea what a
  port is, where its data goes, or how to update it. y4bo does. So chezmoi
  stops at "y4bo is installed" and the Playnite RohanKar extension reads
  y4bo's export to surface the library.

  Quiver used to be installed here too. Dropped 2026-10-03: y4bo's shelf
  carries the curated ports and can opt in to the whole Quiver catalogue, so
  two launchers for the same job was one too many.

  OS GUARDS LIVE HERE, not in .chezmoiignore. That file matches TARGET paths, so
  a `.chezmoiexternals/**` entry there is a no-op — externals run regardless.
  The guard has to be inside the external, like mise.toml.tmpl does it.

  VERSIONS ARE PINNED on purpose (same as mise.toml.tmpl). "latest" would mean a
  silent upgrade on any `chezmoi apply`, which is the opposite of reproducible.
  y4bo self-updates from its own release channel after the first install, so
  this pin only matters for a fresh machine. To bump: change the version below,
  run `chezmoi apply`.

  NEVER point this at Kilted-Kraken/-RohanKar-Launcher (upstream). It did
  until 2026-10-03, pinned at 1.4.1, and `chezmoi apply` silently installed
  upstream over the fork (1.6.0-fork.18) because the install script only
  compared version prefixes. Upstream has no shelf, no export, no Playnite
  handshake.
*/}}

{{- $ymirVersion := "v0.3.3" }}
{{- $y4boVersion := "1.6.0-fork.18" }}

{{ if eq .chezmoi.os "windows" }}
# ── Ymir (emulator) ─────────────────────────────────────────────────────────
# Sega Saturn, standalone. No scoop or winget package exists, and the libretro
# core is an unofficial port whose builds expire, so the release zip it is.
# Emulators get their own folder beside launchers/. AVX2 build (Ryzen 7 7800X3D,
# checked 2026-09-25); use the SSE2 zip on a CPU without it. Files sit at the zip
# root, hence stripComponents 0. exact = false keeps Ymir's profile folder
# (settings, BIOS path, saves) across version bumps. Windows only: this block is
# inside the windows guard, and Playnite's built-in Ymir profile runs ymir-sdl3.exe.
[".local/share/emulators/ymir"]
    type = "archive"
    url = "https://github.com/ymir-emu/Ymir/releases/download/{{ $ymirVersion }}/ymir-windows-x86_64-AVX2-{{ $ymirVersion }}.zip"
    exact = false
    stripComponents = 0
    refreshPeriod = "720h"

# ── y4bo (the RohanKar Launcher fork) ───────────────────────────────────────
# Ships an electron-builder NSIS INSTALLER only, no portable build. So we fetch
# the setup exe here and let run_onchange_after_install-rohankar.ps1
# silent-install it (/S /D=). Downloading is idempotent; installing needs the
# separate script because chezmoi externals can only place files, not run them.
# Install dir stays Programs\rohankar-launcher so the Playnite extension's
# default path and the export file location do not move.
[".local/share/launchers/_installers/y4bo-setup.exe"]
    type = "file"
    url = "https://github.com/yabo-san/RohanKar-Launcher/releases/download/v{{ $y4boVersion }}/y4bo-Setup-{{ $y4boVersion }}.exe"
    refreshPeriod = "720h"

{{ end }}

{{/* Linux: y4bo has no Linux release yet; add it here when a Linux box needs it.
     macOS: no gaming setup on the Mac, nothing is emitted here on purpose. */}}
