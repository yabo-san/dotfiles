{{/* Devsy CLI - devcontainer orchestrator (github.com/devsy-org/devsy), the maintained successor to DevPod. Runs on Windows too - no scoop equivalent, so chezmoi owns it everywhere. */}}
[".local/bin/devsy{{ if eq .chezmoi.os "windows" }}.exe{{ end }}"]
type = "file"
executable = true
{{ if eq .chezmoi.os "darwin" }}
url = "https://github.com/devsy-org/devsy/releases/download/v1.17.0/devsy-darwin-{{.chezmoi.arch}}"
{{ else if eq .chezmoi.os "windows" }}
url = "https://github.com/devsy-org/devsy/releases/download/v1.17.0/devsy-windows-{{.chezmoi.arch}}.exe"
{{ else }}
url = "https://github.com/devsy-org/devsy/releases/download/v1.17.0/devsy-linux-{{.chezmoi.arch}}"
{{ end }}
