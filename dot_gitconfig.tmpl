[user]
	name = yabo
	email = seniorpepex@gmail.com
[core]
	editor = code --wait
	pager = delta
	# Never convert to CRLF on checkout. Git for Windows defaults to autocrlf=true,
	# which rewrites shell scripts as CRLF and breaks them in Linux dev containers
	# (a #!/bin/bash line ending in a hidden carriage return gives exit 127). "input" keeps LF on disk.
	autocrlf = input
# GitHub auth goes through the gh CLI. `gh` is resolved on PATH on every OS
# (scoop shims on Windows, brew on mac). Do NOT hardcode a gh.exe path here:
# the old one pointed at C:\Program Files\GitHub CLI, which does not exist
# with a scoop install, so an apply would have broken every push. The empty
# `helper =` first clears any helper inherited from the system config.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
[merge]
	conflictStyle = zdiff3
[interactive]
	diffFilter = delta --color-only
