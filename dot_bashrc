# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth

shopt -s histappend

HISTSIZE=1000
HISTFILESIZE=2000

shopt -s checkwinsize



if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac


if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
fi




if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
# bash theme - partly inspired by https://github.com/ohmyzsh/ohmyzsh/blob/master/themes/robbyrussell.zsh-theme
__bash_prompt() {
    # DevPod containers show DEVPOD instead of the image's generic "vscode" user (via DEVPOD_WORKSPACE_ID).
    local userpart='`export XIT=$? \
        && if [ ! -z "${DEVPOD_WORKSPACE_ID:-}" ]; then echo -n "\[\033[0;32m\]DEVPOD "; \
           elif [ ! -z "${GITHUB_USER:-}" ]; then echo -n "\[\033[0;32m\]@${GITHUB_USER:-} "; \
           else echo -n "\[\033[0;32m\]\u "; fi \
        && [ "$XIT" -ne "0" ] && echo -n "\[\033[1;31m\]➜" || echo -n "\[\033[0m\]➜"`'
    local gitbranch='`\
        if [ "$(git config --get devcontainers-theme.hide-status 2>/dev/null)" != 1 ] && [ "$(git config --get codespaces-theme.hide-status 2>/dev/null)" != 1 ]; then \
            export BRANCH="$(git --no-optional-locks symbolic-ref --short HEAD 2>/dev/null || git --no-optional-locks rev-parse --short HEAD 2>/dev/null)"; \
            if [ "${BRANCH:-}" != "" ]; then \
                echo -n "\[\033[0;36m\](\[\033[1;31m\]${BRANCH:-}" \
                && if [ "$(git config --get devcontainers-theme.show-dirty 2>/dev/null)" = 1 ] && \
                    git --no-optional-locks ls-files --error-unmatch -m --directory --no-empty-directory -o --exclude-standard ":/*" > /dev/null 2>&1; then \
                        echo -n " \[\033[1;33m\]✗"; \
                fi \
                && echo -n "\[\033[0;36m\]) "; \
            fi; \
        fi`'
    local lightblue='\[\033[1;34m\]'
    local removecolor='\[\033[0m\]'
    PS1="${userpart} ${lightblue}\w ${gitbranch}${removecolor}\$ "
    unset -f __bash_prompt
}
__bash_prompt
export PROMPT_DIRTRIM=4

if [[ "$TERM" == "xterm" ]]; then
    preexec() {
        local cmd="${BASH_COMMAND}"
        echo -ne "\033]0;${USER}@${HOSTNAME}: ${cmd}\007"
    }

    precmd() {
        echo -ne "\033]0;${USER}@${HOSTNAME}: ${SHELL}\007"
    }

    trap 'preexec' DEBUG

    PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }precmd"
fi
set -o vi
eval "$(mise activate bash)"

alias v=nvim
alias gp="git pull"
alias gs="git status"
alias lg=lazygit

if command -v bat > /dev/null ; then
  alias cat="bat"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -lathr'
  alias lla='ls -lgha'
  alias lt='ls --tree'
fi

command -v fastfetch > /dev/null && alias ff='fastfetch' && alias neofetch='fastfetch'
command -v btop  > /dev/null && alias top='btop'
command -v dust  > /dev/null && alias du='dust'
command -v duf   > /dev/null && alias df='duf'
command -v procs > /dev/null && alias ps='procs'

# yazi: the shell cd's to where you quit
if command -v yazi > /dev/null ; then
  function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
  }
fi

alias k='kubectl'
alias kgp='kubectl get pods'
alias kctx='kubectx'
alias kns='kubens'
if command -v kubectl > /dev/null ; then
  source <(kubectl completion bash)
  complete -F __start_kubectl k
fi

alias lastmod='find . -type f -not -path "*/\.*" -exec ls -lrt {} +'
# icloud/sb are Mac paths — inert here, kept for parity when this file lands on a Mac
alias icloud='cd ~/Library/Mobile\ Documents/com~apple~CloudDocs'
alias sb='cd ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/sb'

command -v rg   > /dev/null && alias grep='rg'
command -v fd   > /dev/null && alias find='fd'
alias wget='curl -L -O'

mkcd() { mkdir -p "$1" && cd "$1"; }

alias reload='source ~/.bashrc'

# dormin — opencode. Default model is ollama on yabohome (tailscale :11434).
dormin() {
  if [ $# -eq 0 ]; then
    opencode
  else
    opencode run --auto "$@"
  fi
}

# zoxide last, so it owns `cd`.
if command -v zoxide > /dev/null ; then
  eval "$(zoxide init bash --cmd cd)"
fi

# dssh: docker exec into the workspace container, around devpod ssh's Windows-only "parameter is incorrect" bug.
dssh() {
  local workspace="${1:?usage: dssh <devpod-workspace-name>}"
  local cid
  cid=$(docker ps --format '{{.ID}}\t{{.Image}}' | awk -v w="vsc-$workspace" '$2 ~ w {print $1; exit}')
  if [ -z "$cid" ]; then
    echo "dssh: no running container found for workspace '$workspace'" >&2
    return 1
  fi
  # -u/-w match devcontainer.json; root at / has no dotfiles or mise and looks broken.
  docker exec -it -u vscode -w "/workspaces/$workspace" "$cid" bash
}

# devpod: same verbs as the PowerShell wrapper, over devsy. Names default to this folder's name.
devpod() {
  local verb="$1"
  [ $# -gt 0 ] && shift
  local here
  here="$(basename "$PWD" | tr '[:upper:]' '[:lower:]')"
  case "$verb" in
    "")     devsy workspace list ;;
    up)     [ $# -eq 0 ] && set -- "."     ; devsy workspace up "$@" --ide none ;;
    ssh)    [ $# -eq 0 ] && set -- "$here" ; devsy workspace ssh "$@" -q ;;
    stop)   [ $# -eq 0 ] && set -- "$here" ; devsy workspace stop "$@" ;;
    delete) [ $# -eq 0 ] && set -- "$here" ; devsy workspace delete "$@" ;;
    *)      devsy workspace "$verb" "$@" ;;
  esac
}
