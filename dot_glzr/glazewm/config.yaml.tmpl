# GlazeWM. Generated by chezmoi from this template and .chezmoidata/glazewm.yaml; edit those, not
# ~/.glzr/glazewm/config.yaml. Why it is set up this way: dot_config/bootstrap/how-it-works.md.
# Every key: dot_config/bootstrap/keyboard-map.md.
#
# Opt-in: only apps listed in .chezmoidata/glazewm.yaml are managed. Everything else (games,
# installers, unknown windows) is ignored and floats where it opens.
# Monitors are 0-based, left to right: 0 Acer, 1 CRT, 2 ultrawide (`glazewm query monitors`).

general:
  startup_commands: []
  shutdown_commands: []
  config_reload_commands: []
  focus_follows_cursor: false
  toggle_workspace_on_refocus: true # pressing the current workspace's key goes back to the last one
  cursor_jump:
    enabled: true
    trigger: "window_focus" # the cursor follows focus, Alt+Tab included
  hide_method: "cloak"
  show_all_in_taskbar: false

gaps:
  scale_with_dpi: true
  inner_gap: "10px"
  outer_gap:
    top: "40px" # room for the yasb bar
    right: "10px"
    bottom: "10px"
    left: "10px"

window_effects:
  focused_window:
    border:
      enabled: true
      color: "#8dbcff"
    hide_title_bar:
      enabled: false
    corner_style:
      enabled: false
      style: "square"
    transparency:
      enabled: false
      opacity: "95%"
  other_windows:
    border:
      enabled: true
      color: "#a1a1a1"
    hide_title_bar:
      enabled: false
    corner_style:
      enabled: false
      style: "square"
    transparency:
      enabled: false
      opacity: "0%"

window_behavior:
  initial_state: "floating" # the rules below decide what tiles
  state_defaults:
    floating:
      centered: true
      shown_on_top: false
    fullscreen:
      maximized: false
      shown_on_top: false

workspaces:
  - { name: "1", display_name: "", keep_alive: true, bind_to_monitor: 2 } # main
  - { name: "2", display_name: "", keep_alive: true, bind_to_monitor: 0 } # comms
  - { name: "3", display_name: "", keep_alive: true, bind_to_monitor: 0 } # music and media
  - { name: "4", display_name: "", keep_alive: true, bind_to_monitor: 2 } # dev and gamedev
  - { name: "5", display_name: "", keep_alive: true, bind_to_monitor: 2 } # play
  - { name: "6", display_name: "", keep_alive: true }                     # spare
  - { name: "7", display_name: "", keep_alive: true, bind_to_monitor: 2 } # utilities and launchers
  - { name: "8", display_name: "", bind_to_monitor: 1 }                   # crt; not kept alive so Playnite shows through
  - { name: "9" }                                                         # spare
  - { name: "10" }                                                        # spare
  - { name: "0" } # unused; removing it makes wm-reload-config fail on 3.10.1

window_rules:
{{- $all := list }}
{{- range .glazewm.rules }}
{{-   $ws := .ws }}{{ $note := .note }}
{{-   range $mode := list "tile" "float" }}
{{-     $apps := list }}
{{-     range $.glazewm.rules }}{{ if eq .ws $ws }}{{ range .apps }}
{{-       if eq $mode (ternary "float" "tile" (and (hasKey . "float") .float)) }}{{ $apps = append $apps . }}{{ end }}
{{-     end }}{{ end }}{{ end }}
{{-     if $apps }}
  - commands: [{{ if eq $mode "tile" }}"set-tiling", {{ end }}"move --workspace {{ $ws }}"] # {{ $note }}{{ if eq $mode "float" }}, floating{{ end }}
    match:
{{-       range $apps }}
{{-         $all = append $all .p }}
      - window_process: { regex: "^({{ .p }})$" }
{{-         if hasKey . "class" }}
        window_class: { equals: "{{ .class }}" }
{{-         end }}
{{-         if hasKey . "title" }}
        window_title: { equals: "{{ .title }}" }
{{-         end }}
{{-         if hasKey . "titleRegex" }}
        window_title: { regex: "{{ .titleRegex }}" }
{{-         end }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}

  - commands: ["ignore"]
    match:
      - window_title: { regex: "[Pp]icture.in.[Pp]icture" } # browser pop-out video
        window_class: { regex: "Chrome_WidgetWin_1|MozillaDialogClass" }
      - window_title: { regex: "yabo-shader-hud" }
      - window_process: { not_regex: "^({{ join "|" $all }})$" } # everything not listed above

binding_modes: []

keybindings:
  # move window. Right is Win+L through Raycast (glaze-move-right.ps1); Windows keeps Win+L for itself.
  - { commands: ["move --direction left"], bindings: ["lwin+h"] }
  - { commands: ["move --direction down"], bindings: ["lwin+j"] }
  - { commands: ["move --direction up"], bindings: ["lwin+k"] }

  - { commands: ["toggle-tiling"], bindings: ["lwin+t"] }
  - { commands: ["toggle-fullscreen"], bindings: ["lwin+m"] }
  - { commands: ["close"], bindings: ["alt+q"] } # Cmd+Q parity

  # next / previous window, any workspace, the mouse follows. Alt+Tab stays Windows' own switcher.
  - commands: ["shell-exec conhost.exe --headless pwsh -NoProfile -File %USERPROFILE%\\.config\\scripts\\glazewm\\cycle-window.ps1 1"]
    bindings: ["lwin+tab"]
  - commands: ["shell-exec conhost.exe --headless pwsh -NoProfile -File %USERPROFILE%\\.config\\scripts\\glazewm\\cycle-window.ps1 -1"]
    bindings: ["lwin+shift+tab"]

  - { commands: ["wm-toggle-pause"], bindings: ["lwin+shift+p"] }
  # 3.10.1 drops every window onto the focused workspace on reload; safe-reload puts them back
  - commands: ["shell-exec pwsh -NoProfile -WindowStyle Hidden -File %USERPROFILE%\\.config\\scripts\\glazewm\\safe-reload.ps1"]
    bindings: ["lwin+r"]
  - { commands: ["wm-redraw"], bindings: ["lwin+shift+r"] }

  # workspaces: 1 2 3 4, Q play, W utils, C crt, F V A spares. Numbers stay too, so Windows never
  # gets Win+N for "open taskbar app N".
  - { commands: ["focus --workspace 1"], bindings: ["lwin+1"] }
  - { commands: ["focus --workspace 2"], bindings: ["lwin+2"] }
  - { commands: ["focus --workspace 3"], bindings: ["lwin+3"] }
  - { commands: ["focus --workspace 4"], bindings: ["lwin+4"] }
  - { commands: ["focus --workspace 5"], bindings: ["lwin+q", "lwin+5"] }
  - { commands: ["focus --workspace 6"], bindings: ["lwin+f", "lwin+6"] }
  - { commands: ["focus --workspace 7"], bindings: ["lwin+w", "lwin+7"] }
  - { commands: ["focus --workspace 8"], bindings: ["lwin+c", "lwin+8"] }
  - { commands: ["focus --workspace 9"], bindings: ["lwin+v", "lwin+9"] }
  - { commands: ["focus --workspace 10"], bindings: ["lwin+a", "lwin+0"] }

  # send window there. No Win+Shift+S: that stays the snip.
  - { commands: ["move --workspace 1", "focus --workspace 1"], bindings: ["lwin+shift+1"] }
  - { commands: ["move --workspace 2", "focus --workspace 2"], bindings: ["lwin+shift+2"] }
  - { commands: ["move --workspace 3", "focus --workspace 3"], bindings: ["lwin+shift+3"] }
  - { commands: ["move --workspace 4", "focus --workspace 4"], bindings: ["lwin+shift+4"] }
  - { commands: ["move --workspace 5", "focus --workspace 5"], bindings: ["lwin+shift+q", "lwin+shift+5"] }
  - { commands: ["move --workspace 6", "focus --workspace 6"], bindings: ["lwin+shift+f", "lwin+shift+6"] }
  - { commands: ["move --workspace 7", "focus --workspace 7"], bindings: ["lwin+shift+w", "lwin+shift+7"] }
  - { commands: ["move --workspace 8", "focus --workspace 8"], bindings: ["lwin+shift+c", "lwin+shift+8"] }
  - { commands: ["move --workspace 9", "focus --workspace 9"], bindings: ["lwin+shift+v", "lwin+shift+9"] }
  - { commands: ["move --workspace 10", "focus --workspace 10"], bindings: ["lwin+shift+a", "lwin+shift+0"] }

  # move the whole workspace to another monitor
  - { commands: ["move-workspace --direction left"], bindings: ["lwin+shift+h"] }
  - { commands: ["move-workspace --direction down"], bindings: ["lwin+shift+j"] }
  - { commands: ["move-workspace --direction up"], bindings: ["lwin+shift+k"] }
  - { commands: ["move-workspace --direction right"], bindings: ["lwin+shift+l"] }
